# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Public URL of the app; used in email links.
FRONTEND_URL=http://localhost:5173

# --- Database and Redis ---
POSTGRES_DB=servicedesk
POSTGRES_USER=servicedesk
POSTGRES_PASSWORD=servicedesk

# --- Email (Mailpit in development) ---
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=ServiceDesk <no-reply@servicedesk.local>

# --- Billing ---
# "dev" = clearly labelled simulated billing, no payment provider needed.
# "stripe" = Stripe TEST mode; also set the keys and each Plan's stripe_price_id.
BILLING_PROVIDER=dev
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Proxies in front of Django that append X-Forwarded-For. 1 = nginx only; 2 = a TLS proxy in front of nginx.
# Rate limits key on the client address these proxies report, so this must match your setup.
TRUSTED_PROXY_COUNT=1

# --- Production only (config.settings.prod) ---
# Behind a TLS proxy keep these true. For a local plain-HTTP trial of the prod stack set them false.
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
# Allow `manage.py seed_demo` on a non-DEBUG server (public demo only).
ALLOW_DEMO_DATA=false
